# API Configuration
VITE_API_URL=http://localhost:3000

# Smart Contract Addresses
VITE_ESCROW_CONTRACT_MAINNET=0x...
VITE_ESCROW_CONTRACT_TESTNET=0x...

# Wallet Connect
VITE_WALLETCONNECT_PROJECT_ID=walletconnect_project_id

# Thirdweb
VITE_THIRDWEB_CLIENT_ID=thirdweb_client_id

# Dynamic embedded (smart) wallet. Public value, safe in the client bundle.
# The whole embedded-wallet feature (in-app wallet, PIN, onboarding) is OFF
# until this is set; the Dynamic SDK is lazy-loaded so it isn't even downloaded
# without it. Leave empty to keep external-wallet-only behaviour.
VITE_DYNAMIC_ENV_ID=

# Quidax on/off-ramp widget (publishable "pub_" key, safe for the client)
VITE_QUIDAX_PUBLIC_KEY=pub_xxxxxxxxxxxxxxxxxxxxxxxx

# Google One Tap sign-in (same OAuth client id the backend verifies against).
# Public value, safe in the client bundle. When set, the login nudge shows Google
# One Tap; when unset, the nudge renders nothing. The client id's "Authorized
# JavaScript origins" in Google Cloud Console must list every origin the app runs
# on (https://dezenmart.com, https://www.dezenmart.com, the netlify host, and
# http://localhost:5173) or One Tap silently refuses to display.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Divvi Referral System
VITE_DIVVI_CONSUMER_ADDRESS=0x...

# Squid cross-chain bridge integrator id (Optional). When set, the "Move funds
# to Celo" step shows an in-app Squid bridge widget (destination locked to Celo).
# Get one from the Squid dashboard. Unset = the text guide is shown instead.
VITE_SQUID_INTEGRATOR_ID=

# Logistics provider dashboard (Optional). When set, LOGISTICS_ORDER_PENDING
# notifications show an "Open provider dashboard" button linking here; when unset
# the sheet just tells the provider to sign in to their dashboard.
VITE_LOGISTICS_PORTAL_URL=

# Sentry Error Tracking (Optional - only for production)
VITE_SENTRY_DSN=https://sentry-dsn@sentry.io/project-id

# Analytics (Optional)
VITE_ANALYTICS_ENDPOINT=https://analytics-endpoint.com/api/metrics

# Google Analytics (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Card / bank (fiat) checkout. OFF unless set to exactly "on".
# The provider integration in src/services/fiatPaymentService.ts is still a
# stub: it contacts no provider and its checkout screen offers a "Simulate
# Successful Payment" button that marks the order accepted on the backend.
# Keep this unset in production until that service calls real endpoints and
# payments are verified server-side.
VITE_FIAT_PAYMENT=

# Payment features (compliance hold). OFF unless set to exactly "on".
# Hides every surface that moves money: the pay step on an order, escrow
# actions (confirm delivery, raise dispute, cancel), wallet connection, the
# Quidax on/off-ramp, token swap and the trade checkout routes. Ordering is
# deliberately unaffected - buyers can still place orders, they just cannot pay.
# Set to "on" once the refund policy and escrow policy are published.
VITE_PAYMENTS=
