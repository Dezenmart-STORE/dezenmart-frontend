# API Configuration
VITE_API_URL=http://localhost:3000

# Smart Contract Addresses
VITE_ESCROW_CONTRACT_MAINNET=0x...
VITE_ESCROW_CONTRACT_TESTNET=0x...

# Wallet Connect
VITE_WALLETCONNECT_PROJECT_ID=walletconnect_project_id

# Thirdweb
VITE_THIRDWEB_CLIENT_ID=thirdweb_client_id

# Quidax on/off-ramp widget (publishable "pub_" key, safe for the client)
VITE_QUIDAX_PUBLIC_KEY=pub_xxxxxxxxxxxxxxxxxxxxxxxx

# Google One Tap sign-in (same OAuth client id the backend verifies against).
# Public value, safe in the client bundle. When set, the login nudge shows Google
# One Tap; when unset, the nudge renders nothing. The client id's "Authorized
# JavaScript origins" in Google Cloud Console must list every origin the app runs
# on (https://dezenmart.com, https://www.dezenmart.com, the netlify host, and
# http://localhost:5173) or One Tap silently refuses to display.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Divvi Referral System
VITE_DIVVI_CONSUMER_ADDRESS=0x...

# Sentry Error Tracking (Optional - only for production)
VITE_SENTRY_DSN=https://sentry-dsn@sentry.io/project-id

# Analytics (Optional)
VITE_ANALYTICS_ENDPOINT=https://analytics-endpoint.com/api/metrics

# Google Analytics (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
