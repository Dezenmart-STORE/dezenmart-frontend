# `npm run dev:mock`: the app runs against the in-browser mock backend
# (src/mocks). No secrets here; the API host is a placeholder MSW intercepts.
VITE_API_URL=https://api.mock.local/api/v1
VITE_ENABLE_BANK_TRANSFER=true
# The wallet setup refuses to load without a WalletConnect id. Mock mode never
# connects a real wallet, so a placeholder lets it run where there is no .env (CI).
VITE_WALLETCONNECT_PROJECT_ID=mock-project-id
